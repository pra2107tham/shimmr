# Copy to .env.local for development, and set the same two in Vercel
# (Project Settings -> Environment Variables) for the deployed site.
#
# Both are meant to be public — NEXT_PUBLIC_* ships in the browser bundle by
# design. What actually protects a signed-in person's data is Postgres row
# level security (supabase/migrations/20260905000000_web_auth_and_dashboard.sql),
# not secrecy of these two values. Never put the service role key here or
# anywhere in site/ — that key bypasses RLS entirely and belongs only where
# it already lives: the Edge Functions' runtime environment.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://fpxntzwkiepnwsazmaxf.supabase.co

# Project Settings -> API -> Project API keys -> anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's own canonical URL, for SEO metadata (canonical links, Open
# Graph/Twitter card URLs, robots.txt/sitemap.xml). Optional — app/seo.ts
# falls back to the same URL already committed at packaging/site_url (what
# the CLI's browser sign-in points at), so this only needs setting if the
# two ever diverge, e.g. after moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://shimmr-ten.vercel.app
